# Copy to .env.development for local service runs. This file is never committed.
GOOD_BADMINTON_APP_ENV=development

# Mini Program and WebUI both call this business gateway in local development.
GOOD_BADMINTON_BUSINESS_HOST=127.0.0.1
GOOD_BADMINTON_BUSINESS_PORT=8080
GOOD_BADMINTON_BUSINESS_API_URL=http://127.0.0.1:8080
GOOD_BADMINTON_BUSINESS_STREAM_URL=http://127.0.0.1:8080

# Operator API (FastAPI) and Next.js SaaS console.
# The browser-safe base URL is public to the console but must never contain keys.
GOOD_BADMINTON_OPERATOR_API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# NEXT_PUBLIC_OPERATOR_API_BASE_URL=http://127.0.0.1:8000

# Server-side only: set the GPU endpoint/key in the ignored local env files.
# GOOD_BADMINTON_GPU_API_URL=http://127.0.0.1:8090
# GOOD_BADMINTON_GPU_API_KEY=replace-me
# At least 32 bytes, server-side only.  It derives revocable terminal signing
# secrets; do not put it in a Mini Program build, terminal image, or Git.
# GOOD_BADMINTON_EDGE_MASTER_KEY=replace-with-a-high-entropy-server-secret
# GOOD_BADMINTON_EDGE_STAGING_DIR=outputs/edge_staging
# GOOD_BADMINTON_EDGE_PREVIEW_DIR=outputs/edge_preview
# GOOD_BADMINTON_EDGE_RECORDING_DIR=outputs/edge_recordings
# GOOD_BADMINTON_EDGE_GATEWAY_PUBLIC_URL=http://127.0.0.1:18080
# GOOD_BADMINTON_EDGE_GATEWAY_INTERNAL_URL=http://127.0.0.1:18080

# Optional, server-side only: the AI promotion renderer sends a small,
# timestamped anonymous-evidence JSON and up to four annotated, low-resolution
# moment frames (never the source video) once per completed video. Without
# these settings it still renders deterministic visual-observation placeholders.
# GOOD_BADMINTON_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# GOOD_BADMINTON_LLM_API_KEY=replace-with-llm-api-key
# GOOD_BADMINTON_LLM_MODEL=your-model-name
# GOOD_BADMINTON_LLM_TIMEOUT_SECONDS=75
