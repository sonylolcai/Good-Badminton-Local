# Copy to .gpu-api.local.env, replace the key, and keep that local file untracked.
GOOD_BADMINTON_API_KEY=replace-with-a-long-random-secret
GOOD_BADMINTON_LOCAL_PORT=8080

# Put optional local weights in ./weights. Compose mounts that directory at
# the application's normal /app/weights path, so no model-path override is needed.
GOOD_BADMINTON_STREAM_SEGMENT_TIMEOUT_SECONDS=10
