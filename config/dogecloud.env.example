# Server-side only. Loaded by the DogeCloud media storage adapter.
GOOD_BADMINTON_MEDIA_STORAGE_PROVIDER=dogecloud
# Explicit server-owned media environment; use production for real deployments.
DOGECLOUD_MEDIA_ENVIRONMENT=test
DOGECLOUD_ACCESS_KEY=
DOGECLOUD_SECRET_KEY=
DOGECLOUD_BUCKET=
DOGECLOUD_CDN_BASE_URL=
DOGECLOUD_CDN_SIGNING_KEY=
DOGECLOUD_RETENTION_DAYS=7
