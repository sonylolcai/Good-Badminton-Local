# Keep the real production file outside source control, or inject these values
# from the deployment platform. Never put GPU keys or database URLs in the
# Mini Program build configuration.
GOOD_BADMINTON_APP_ENV=production

# Public HTTPS endpoint used by the Mini Program and WebUI.
GOOD_BADMINTON_BUSINESS_API_URL=https://api.example.com
GOOD_BADMINTON_BUSINESS_STREAM_URL=https://api.example.com

# Business service listener, normally behind TLS reverse proxy.
GOOD_BADMINTON_BUSINESS_HOST=0.0.0.0
GOOD_BADMINTON_BUSINESS_PORT=8080

# Operator API CORS allowlist. The Next.js console must be protected by SSO/VPN.
GOOD_BADMINTON_OPERATOR_API_ALLOWED_ORIGINS=https://operator.example.com
# Public API origin used when building the Next.js console; it must not contain keys.
# NEXT_PUBLIC_OPERATOR_API_BASE_URL=https://operator-api.example.com

# Server-side secrets; inject their real values only through the runtime.
# GOOD_BADMINTON_BUSINESS_DATABASE_URL=postgresql://...
# GOOD_BADMINTON_GPU_API_URL=https://gpu-api.example.com
# GOOD_BADMINTON_GPU_API_KEY=replace-me
# GOOD_BADMINTON_EDGE_MASTER_KEY=replace-with-a-high-entropy-server-secret
# GOOD_BADMINTON_EDGE_STAGING_DIR=/var/lib/good-badminton/edge-staging
# GOOD_BADMINTON_EDGE_PREVIEW_DIR=/var/lib/good-badminton/edge-preview
# GOOD_BADMINTON_EDGE_RECORDING_DIR=/var/lib/good-badminton/edge-recordings
# Browser-facing HTTPS gateway origin. It never contains terminal credentials.
# GOOD_BADMINTON_EDGE_GATEWAY_PUBLIC_URL=https://api.example.com
# Server-to-server edge gateway origin; keep this private/loopback.
# GOOD_BADMINTON_EDGE_GATEWAY_INTERNAL_URL=http://127.0.0.1:18080
