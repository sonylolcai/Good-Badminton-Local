# Copy to .gpu-api.env on the GPU server, replace the key, then chmod 600.
# Keep this file local to the server; it is intentionally ignored by Git.
GOOD_BADMINTON_APP_ENV=production
GOOD_BADMINTON_API_KEY=replace-with-a-long-random-secret
GOOD_BADMINTON_API_DATA_DIR=/opt/good-badminton/api_data
PORT=8080

# Optional launcher consistency check. The fixed Python entry point, rather
# than this variable, selects the sport. Set this to badminton for
# start_badminton_gpu_container.sh or tennis for start_tennis_gpu_container.sh.
# A mismatched value fails before Uvicorn starts; never expose it as a WebUI or
# request-time selector.
GOOD_SPORT_VISION_PROFILE=badminton

# Stream-session.v1 production composition.  Calibrations are immutable JSON
# files named <calibration_id>.json.  Stream sessions are retained only after
# reaching a terminal state; run the documented maintenance cleanup explicitly.
GOOD_BADMINTON_STREAM_RETENTION_HOURS=72
# A hung third-party decode/inference call cannot be killed safely inside a
# Python thread. After this deadline the API persists the failed segment and
# exits with code 75; the container launcher restarts it and continues later
# fragments as a new, explicitly partial continuity epoch.
# A two-second source segment has at most ten wall-clock seconds to finish.
# A timeout is persisted as a failed segment and subsequent segments continue.
GOOD_BADMINTON_STREAM_SEGMENT_TIMEOUT_SECONDS=10
GOOD_BADMINTON_STREAM_POSE_MODEL=/opt/good-badminton/weights/yolo11n-pose.pt
GOOD_BADMINTON_STREAM_BALL_MODEL=/opt/good-badminton/weights/yolo11s-ball.pt
# TrackNet is loaded only for badminton stream sessions that request it. The
# checkpoint is provisioned separately from the source-only GPU ZIP.
# GOOD_BADMINTON_STREAM_TRACKNET_MODEL=/root/good-badminton-gpu-api-state/models/tracknetv3/ckpts/TrackNet_best.pt
# GOOD_BADMINTON_STREAM_TRACKNET_DEVICE=auto
# GOOD_BADMINTON_STREAM_TRACKNET_MAX_FRAME_INTERVAL_RATIO=1.5
GOOD_BADMINTON_STREAM_DEVICE=auto
GOOD_BADMINTON_STREAM_POSE_CONF=0.15

# Media validation phase: decode_smoke exercises the stream engine without
# loading models. Use a separate data directory when changing this mode;
# existing sessions cannot be restored under a different processing mode.
GOOD_BADMINTON_STREAM_PROCESSING_MODE=analysis
# Enable only after installing requirements-media.txt and configuring private OSS.
GOOD_BADMINTON_MEDIA_ARCHIVE_ENABLED=0
# Choose dogecloud after deploying the business media registry migration.
# GOOD_BADMINTON_MEDIA_STORAGE_PROVIDER=dogecloud
# DOGECLOUD_ENV_FILE=/secure/project/.secrets/dogecloud.env
# Required before accepting direct media; also reserved during assembly.
GOOD_BADMINTON_STREAM_MIN_FREE_BYTES=10737418240
GOOD_BADMINTON_STREAM_MAX_CACHE_BYTES=25769803776
GOOD_BADMINTON_STREAM_MAX_SESSION_BYTES=8589934592
GOOD_BADMINTON_STREAM_MAX_SOURCE_SECONDS=2700
GOOD_BADMINTON_STREAM_MAX_SEGMENTS=4096
GOOD_BADMINTON_STREAM_MAX_REQUEST_BYTES=35651584
GOOD_BADMINTON_STREAM_MAX_UPLOAD_REQUESTS=4
# Needed for direct-upload token issuance; the venue renews short-lived tokens.
GOOD_BADMINTON_UPLOAD_TOKEN_TTL_SECONDS=3600
# Release only remotely verified duplicate video files, never manifests/events.
GOOD_BADMINTON_MEDIA_LOCAL_CLEANUP_ENABLED=1
GOOD_BADMINTON_MEDIA_LOCAL_CACHE_GRACE_SECONDS=300
# GOOD_BADMINTON_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# GOOD_BADMINTON_OSS_REGION=cn-hangzhou
# GOOD_BADMINTON_OSS_BUCKET=your-private-bucket
# GOOD_BADMINTON_OSS_PREFIX=match-media
# The SDK reads OSS_ACCESS_KEY_ID, OSS_ACCESS_KEY_SECRET and optional
# OSS_SESSION_TOKEN from the server environment. Never put them in a manifest.

# Tennis-only deployment: the fixed tennis launcher already selects the sport.
# GOOD_SPORT_VISION_PROFILE may be omitted (or set to tennis as a consistency
# check). A dedicated checkpoint must expose the exact `tennis_ball` label.
# If omitted, tennis can still run pose-only; the optional package flag ships
# the existing badminton model as explicitly experimental ball evidence.
# Tennis never reads GOOD_BADMINTON_STREAM_POSE_MODEL/CONF/DEVICE. Provision
# and configure its own pose checkpoint even when both checkpoints currently
# originate from the same upstream YOLO release.
# GOOD_TENNIS_STREAM_POSE_MODEL=/root/good-tennis-gpu-api-state/weights/yolo11s-pose.pt
# GOOD_TENNIS_STREAM_DEVICE=auto
# GOOD_TENNIS_STREAM_POSE_CONF=0.15
# GOOD_TENNIS_STREAM_BALL_MODEL=/root/good-tennis-gpu-api-state/weights/tennis-ball-yolo.pt
# GOOD_TENNIS_EXPERIMENTAL_BALL_MODEL=/root/good-tennis-gpu-api-state/weights/yolo11s-ball.pt
# GOOD_TENNIS_STREAM_BALL_CONF=0.15

# court_association is restart-restorable and is the safe default. ByteTrack
# is opt-in after its evaluation gate; its third-party runtime state cannot yet
# be restored across an API process restart and will fail closed for rebuild.
GOOD_BADMINTON_STREAM_TRACKER_BACKEND=court_association

# The pure stream service intentionally has no Huji/action model, rally
# derivation, report, LLM or rendering configuration. It publishes anonymous
# visual evidence only; business services may interpret that evidence later.
