# Copy to .env.remote.local and set the HTTPS origin of the remote operator API.
# This value is browser-visible; never put API keys, database URLs, or GPU URLs here.
NEXT_PUBLIC_OPERATOR_API_BASE_URL=https://operator.example.com

# Optional. Local server-rendered pages use the public API by default. Set this
# only when your development machine can reach a different safe API origin.
# OPERATOR_API_SERVER_BASE_URL=https://operator.example.com
