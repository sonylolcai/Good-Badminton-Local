# Set these in the process that starts WebUI. Do not expose the key in browser JS
# or commit a populated file.
GOOD_BADMINTON_GPU_API_URL=http://xn-g.suanjiayun.com:52028
GOOD_BADMINTON_GPU_API_KEY=replace-with-gpu-api-key
# Network timeout per HTTP request; analysis polling has its own longer timeout.
GOOD_BADMINTON_GPU_API_TIMEOUT=30
GOOD_BADMINTON_GPU_API_POLL_SECONDS=2
GOOD_BADMINTON_GPU_JOB_TIMEOUT=43200

# Tennis uses a separately deployed, pure visual-observation GPU service.  The
# WebUI never sends this endpoint to browser JavaScript.  Its single-match
# profile is fixed to two anonymous player tracks and no shuttle model.
GOOD_TENNIS_GPU_API_URL=https://your-tennis-gpu.example.com
GOOD_TENNIS_GPU_API_KEY=replace-with-tennis-gpu-api-key
GOOD_TENNIS_GPU_API_TIMEOUT=30
GOOD_TENNIS_GPU_API_POLL_SECONDS=2
GOOD_TENNIS_STREAM_JOB_TIMEOUT=43200
