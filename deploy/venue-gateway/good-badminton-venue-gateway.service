[Unit]
Description=Good-Badminton venue camera relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=goodbadminton
WorkingDirectory=/opt/good-badminton-venue-gateway
EnvironmentFile=/etc/good-badminton-venue-gateway.env
ExecStart=/opt/good-badminton-venue-gateway/.venv/bin/python agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/good-badminton-venue-gateway

[Install]
WantedBy=multi-user.target
