# Store this file only on the venue Windows gateway. The installer restricts
# access to Administrators, SYSTEM and the installing user.
EDGE_GATEWAY_URL=https://for-one-dream.cloud/badminton-edge
EDGE_DEVICE_ID=SET_BY_BUSINESS_SERVER
EDGE_CAMERA_ID=SET_BY_BUSINESS_SERVER
EDGE_CREDENTIAL_VERSION=v1
EDGE_DEVICE_SECRET=SET_BY_ONE_TIME_PAIRING_RESPONSE

# The venue gateway may know RTSP, but the business server and GPU never receive it.
CAMERA_RTSP_URL=SET_BY_VENUE_OPERATOR
FFMPEG_BIN=SET_BY_INSTALLER
SEGMENT_SECONDS=2
SPOOL_DIR=SET_BY_INSTALLER
HEARTBEAT_SECONDS=10

# Must equal the validated server-side camera calibration exactly.
COURT_CORNERS_JSON=SET_BY_BUSINESS_SERVER
