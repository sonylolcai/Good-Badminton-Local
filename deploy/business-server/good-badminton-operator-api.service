[Unit]
Description=Good-Badminton operator API
After=network-online.target good-badminton-edge-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/good-badminton/business.env
ExecStart=__PYTHON_BIN__ -m uvicorn operator_api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/good-badminton

[Install]
WantedBy=multi-user.target
