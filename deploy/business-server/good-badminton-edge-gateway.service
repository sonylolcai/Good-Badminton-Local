[Unit]
Description=Good-Badminton business edge ingest gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/good-badminton/business.env
ExecStart=__PYTHON_BIN__ -m business_gateway.edge_api
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/good-badminton

[Install]
WantedBy=multi-user.target
