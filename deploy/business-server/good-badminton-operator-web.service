[Unit]
Description=Good-Badminton Next.js operator web
After=network-online.target good-badminton-operator-api.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__/webui-next
EnvironmentFile=/etc/good-badminton/business.env
Environment=NODE_ENV=production
ExecStart=__NPM_BIN__ run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
