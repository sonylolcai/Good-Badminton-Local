# Copy outside the repository, e.g. /etc/good-badminton/business.env.
# chmod 640 root:goodbadminton /etc/good-badminton/business.env

GOOD_BADMINTON_APP_ENV=production

# PostgreSQL business database. Never put it in a Next.js NEXT_PUBLIC variable.
GOOD_BADMINTON_BUSINESS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/bdteach_business

# Used only when admin_accounts is empty. Remove the password from the runtime
# environment after the first successful bootstrap and password change.
GOOD_BADMINTON_BOOTSTRAP_ADMIN_USERNAME=system-admin
GOOD_BADMINTON_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
GOOD_BADMINTON_ADMIN_SESSION_HOURS=12

# The public HTTPS origins shown to the operator browser and used by terminals.
GOOD_BADMINTON_BUSINESS_API_URL=https://api.example.com
GOOD_BADMINTON_BUSINESS_STREAM_URL=https://api.example.com
GOOD_BADMINTON_EDGE_GATEWAY_PUBLIC_URL=https://api.example.com
GOOD_BADMINTON_OPERATOR_API_ALLOWED_ORIGINS=https://operator.example.com

# Server-to-server routing stays on loopback; do not expose these ports.
GOOD_BADMINTON_EDGE_GATEWAY_INTERNAL_URL=http://127.0.0.1:18080
GOOD_BADMINTON_BUSINESS_HOST=127.0.0.1
GOOD_BADMINTON_BUSINESS_PORT=18080

# Required, 32+ bytes. Generate once with: openssl rand -base64 48
# This exact value must be shared by the edge gateway and the operator API.
GOOD_BADMINTON_EDGE_MASTER_KEY=replace-with-a-managed-high-entropy-secret
GOOD_BADMINTON_EDGE_STAGING_DIR=/var/lib/good-badminton/edge-staging
GOOD_BADMINTON_EDGE_PREVIEW_DIR=/var/lib/good-badminton/edge-preview
# Retained raw chunks and the sealed recording.mp4 for completed edge sessions.
GOOD_BADMINTON_EDGE_RECORDING_DIR=/var/lib/good-badminton/edge-recordings
GOOD_BADMINTON_MEDIA_ROOT=/var/lib/good-badminton/business-media
GOOD_BADMINTON_MAX_VIDEO_UPLOAD_BYTES=21474836480

# The anonymous GPU CV service. Its non-health endpoints use X-API-Key.
GOOD_BADMINTON_GPU_API_URL=https://gpu-api.example.com
GOOD_BADMINTON_GPU_API_KEY=replace-with-gpu-api-key

# Compiled into the Next.js production bundle by deploy-business-server.sh.
# Must be the browser-reachable operator API origin and never include secrets.
NEXT_PUBLIC_OPERATOR_API_BASE_URL=https://operator.example.com
