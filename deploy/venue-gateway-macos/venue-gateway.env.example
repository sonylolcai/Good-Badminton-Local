# Store this file only on the venue Mac as venue-gateway.env with chmod 600.
EDGE_GATEWAY_URL=https://for-one-dream.cloud/badminton-edge
EDGE_DEVICE_ID=SET_BY_BUSINESS_SERVER
EDGE_CAMERA_ID=SET_BY_BUSINESS_SERVER
EDGE_CREDENTIAL_VERSION=v1
EDGE_DEVICE_SECRET=SET_BY_ONE_TIME_PAIRING_RESPONSE

# The Mac may know RTSP, but the business server and GPU never receive it.
CAMERA_RTSP_URL=rtsp://USER:PASSWORD@CAMERA-LAN-IP:554/stream1
SEGMENT_SECONDS=2
SPOOL_DIR=SET_BY_INSTALLER
HEARTBEAT_SECONDS=10

# Must equal the validated server-side camera calibration exactly.
COURT_CORNERS_JSON=[[0,0],[1,0],[1,1],[0,1]]
